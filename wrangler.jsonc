{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-auth-starter",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",

  "vars": {
    "ADMIN_ORIGIN": "https://your-admin.example.com"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_DATABASE_NAME",
      "database_id": "YOUR_DATABASE_ID",
      "remote": true
    }
  ]
}
